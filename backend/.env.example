# 智为康乐消费版后端环境变量（复制为 .env 填写；生产全部经环境注入，不入库）
APP_ADDR=:8080

# PostgreSQL 连接串（生产必填；不填回退内存演示模式）
APP_DB_URL=postgres://zhiwellcare:CHANGE_ME@127.0.0.1:5432/zhiwellcare?sslmode=disable

# JWT 访问令牌签名密钥（生产必须注入长随机串）
APP_JWT_SECRET=change-me-to-a-long-random-secret

# 访问令牌有效期（分钟，默认 120）
APP_ACCESS_TTL_MINUTES=120

# 跨端 CORS 允许来源（网页/Tauri/Capacitor 列表）
APP_CORS_ORIGINS=http://localhost:1420,http://localhost:4173,http://tauri.localhost,capacitor://localhost,https://game.zhiwellcare.com

# 日志：结构化 JSON（生产建议 true）、请求日志开关、Gin Debug（生产 false）
APP_LOG_JSON=true
APP_LOG_REQUESTS=true
APP_DEBUG=false

# 启动时把已注册的该手机号用户提升为管理员（RBAC 引导；可留空）
APP_ADMIN_BOOTSTRAP_PHONE=

# 微信开放平台小程序/公众号登录（未配置时微信登录走 Mock，仅供联调）
APP_WECHAT_APPID=
APP_WECHAT_SECRET=
